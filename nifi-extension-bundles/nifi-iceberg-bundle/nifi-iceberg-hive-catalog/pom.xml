    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-ozone-file-system</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.ozone</groupId>
                                    <artifactId>ozone-filesystem-hadoop3</artifactId>
                                    <version>${iceberg.ozone.version}</version>
                                    <outputDirectory>${project.build.directory}/ozone-filesystem</outputDirectory>
                                    <destFileName>ozone-filesystem-hadoop3.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
