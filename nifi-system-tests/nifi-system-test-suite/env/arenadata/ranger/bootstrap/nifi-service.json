{
  "name": "nifi",
  "type": "nifi",
  "description": "NiFi service for system tests",
  "isEnabled": true,
  "configs": {
    "nifi.url": "https://nifi01.demo:8443/nifi-api/resources",
    "nifi.authentication": "SSL",
    "nifi.ssl.use.default.context": "false",
    "nifi.ssl.keystore": "/nifi-certs/nifi01-keystore.p12",
    "nifi.ssl.keystoreType": "PKCS12",
    "nifi.ssl.keystorePassword": "changeit",
    "nifi.ssl.truststore": "/nifi-certs/truststore.p12",
    "nifi.ssl.truststoreType": "PKCS12",
    "nifi.ssl.truststorePassword": "changeit",
    "commonNameForCertificate": ""
  }
}