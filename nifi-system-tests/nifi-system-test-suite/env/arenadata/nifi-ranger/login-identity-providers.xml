<loginIdentityProviders>
    <!--
        Identity Provider for users logging in with username/password against LDAP.
        NOTE: This provider is configured but not used by default.
        The single-user-provider is used for system tests to simplify authentication.
    -->
    <provider>
        <identifier>kerberos-ldap-provider</identifier>
        <class>org.apache.nifi.ldap.LdapProvider</class>
        <property name="Authentication Strategy">SIMPLE</property>

        <property name="Manager DN">cn=Administrator,CN=Users,DC=nifi,DC=test</property>
        <property name="Manager Password">LZ2ibGAn2H0D0UW3</property>

        <property name="TLS - Keystore"></property>
        <property name="TLS - Keystore Password"></property>
        <property name="TLS - Keystore Type"></property>
        <property name="TLS - Truststore"></property>
        <property name="TLS - Truststore Password"></property>
        <property name="TLS - Truststore Type"></property>
        <property name="TLS - Client Auth"></property>
        <property name="TLS - Protocol"></property>
        <property name="TLS - Shutdown Gracefully"></property>

        <property name="Referral Strategy">FOLLOW</property>
        <property name="Connect Timeout">10 secs</property>
        <property name="Read Timeout">10 secs</property>

        <property name="Url">ldap://samba:389</property>
        <property name="User Search Base">OU=people,DC=nifi,DC=test</property>
        <property name="User Search Filter">sAMAccountName={0}</property>

        <property name="Identity Strategy">USE_USERNAME</property>
        <property name="Authentication Expiration">12 hours</property>
    </provider>

    <!--
        Identity Provider for Kerberos authentication
        NOTE: This provider is configured but not used by default.
    -->
    <provider>
        <identifier>kerberos-provider</identifier>
        <class>org.apache.nifi.kerberos.KerberosProvider</class>
        <property name="Default Realm">DEMO</property>
        <property name="Authentication Expiration">12 hours</property>
    </provider>

    <!--
        Single User Provider - USED BY DEFAULT for system tests
        This allows simple authentication without HTTPS requirement.
        The password is auto-generated from SINGLE_USER_CREDENTIALS_PASSWORD env var.
    -->
    <provider>
        <identifier>single-user-provider</identifier>
        <class>org.apache.nifi.authentication.single.user.SingleUserLoginIdentityProvider</class>
        <property name="Username"></property>
        <property name="Password"></property>
    </provider>
</loginIdentityProviders>
